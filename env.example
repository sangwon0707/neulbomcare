# ========================================
# 늘봄케어 - Azure OpenAI 설정
# ========================================
# 이 파일을 .env로 복사하고 API 키를 입력하세요
# cp .env.example .env

# Azure OpenAI API 키 (Azure Portal 또는 AI Foundry에서 확인)
AZURE_OPENAI_API_KEY=여기에_실제_API_키_입력

# Azure OpenAI 엔드포인트 (cognitiveservices.azure.com 형식)
AZURE_OPENAI_ENDPOINT=https://2sesac-donut-resource.cognitiveservices.azure.com/

# 배포 이름 (Azure AI Foundry에서 확인)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API 버전
AZURE_OPENAI_API_VERSION=2024-12-01-preview
